{
  "expo": {
    "name": "NuviaTravel",
    "slug": "NuviaTravel",
    "owner": "nuviaee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/IconNuviaBigger.png",
    "scheme": "nuviatravel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nuviaee.nuviatravel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/IconNuviaBigger.png",
        "backgroundColor": "#0E141C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nuviaee.nuviatravel",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "nuviatravel",
              "host": "*",
              "pathPrefix": "/redirect"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/nuviasprite.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "336dc9cb-c434-456e-b286-ee867cf2f074"
      }
    }
  }
}